PORT=1610
NODE_ENV=production

# This test deployment deliberately uses its own SQLite database.
DB_TYPE=sqlite
DATA_DIR=/app/data
DB_FILENAME=manual-failover-test.db

# Generate a unique value; do not reuse the production AIOManager key.
ENCRYPTION_KEY=REPLACE_WITH_A_NEW_64_CHARACTER_HEX_KEY

# Change this if you choose a different Pangolin test hostname.
CORS_ORIGINS=https://aiomanager-test.peden88.stream

MAX_SYNC_PAYLOAD_SIZE=104857600
MAX_TIMEOUT=20000
LOG_LEVEL=info
LOG_PRETTY_PRINT=true

CUSTOM_HTML=<div style="background:#f59e0b;color:#111827;padding:10px;border-radius:8px;margin-bottom:20px;font-weight:700;text-align:center">MANUAL FAILOVER TEST INSTANCE</div>
